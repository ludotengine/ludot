shader spatial
import "./Noise"
renderMode("unshaded")

--- Boiling granulation with a bright core and a hot, darker limb.

export Core: vec3 = vec3(1.0, 0.86, 0.45)
export Surface: vec3 = vec3(1.0, 0.42, 0.06)
export Intensity: number = 3.2 in 0 to 10 step 0.1

local Local: vec3
local World: vec3

function vertex()
    Local = normalize(Vertex)
    World = (ModelMatrix * vec4(Vertex, 1.0)).xyz
end

function fragment()
    local flow: vec3 = Local * 5.0 + vec3(0, Time * 0.04, Time * 0.02)
    local cells: number = fbm(flow + vec3(fbm(flow * 0.7, 3) * 2.5), 5)
    local view: vec3 = normalize(CameraPosition - World)
    local facing: number = clamp(dot(normalize(World - NodePosition), view), 0.0, 1.0)
    local limb: number = pow(facing, 0.6)
    local color: vec3 = mix(Surface, Core, smoothstep(0.35, 0.75, cells) * limb)
    Albedo = color
    Emission = color * Intensity * (0.6 + 0.6 * limb)
end
