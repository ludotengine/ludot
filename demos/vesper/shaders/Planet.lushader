shader spatial
renderMode("unshaded", "cull_back")

export Ocean: vec3 = vec3(0.025, 0.2, 0.39)
export Land: vec3 = vec3(0.23, 0.49, 0.26)
export Coverage: number = -0.25
export Ice: number = 0.6
export Bands: number = 0
export Ambient: number = 0.18
local WorldPoint: vec3
local LocalPoint: vec3
local Radial: vec3

function vertex()
    WorldPoint = (ModelMatrix * vec4(Vertex, 1.0)).xyz
    LocalPoint = normalize(Vertex)
    Radial = (ModelMatrix * vec4(Normal, 0.0)).xyz
end

function fragment()
    local p: vec3 = LocalPoint
    local terrain: number = sin(p.x * 7.0 + sin(p.z * 9.0)) + cos(p.y * 8.0 + p.z * 3.0)
    local stripes: number = sin(p.y * 28.0 + sin(p.x * 5.0) * 0.7)
    local mask: number = smoothstep(-0.15, 0.2, mix(terrain, stripes, Bands) + Coverage)
    local base: vec3 = mix(Ocean, Land, mask)
    local caps: number = smoothstep(0.75, 0.96, abs(p.y)) * Ice
    base = mix(base, vec3(0.86, 0.91, 0.89), caps)
    local face: vec3 = normalize(cross(dFdx(WorldPoint), dFdy(WorldPoint)))
    face = face * sign(dot(face, Radial))
    local sunlight: number = max(dot(face, normalize(-WorldPoint)), 0.0)
    Albedo = base * (Ambient + sunlight * 0.95)
    Roughness = 1.0
end
