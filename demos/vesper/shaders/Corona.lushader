shader spatial
import "./Noise"
renderMode("unshaded", "cull_front", "blend_add", "depth_test_disabled", "depth_draw_never")

--- A shell around the sun. Brightness falls off with the ray's closest approach to the
--- center, so the halo looks right from any distance and angle. The shell reaches past
--- the inner orbits, so it skips the depth test and hides itself only behind surfaces
--- nearer than the sun's center. Worlds behind the sun then sit inside the glow.

export SceneDepth: DepthTexture
export CompatibilityDepth: number = 0
export StarRadius: number = 46.0
export Tint: vec3 = vec3(1.0, 0.45, 0.12)
export Reach: number = 0.22 in 0.05 to 2 step 0.01

local World: vec3

function vertex()
    World = (ModelMatrix * vec4(Vertex, 1.0)).xyz
end

function fragment()
    local ray: vec3 = normalize(World - CameraPosition)
    local toCenter: vec3 = NodePosition - CameraPosition
    local along: number = max(dot(toCenter, ray), 0.0)

    -- Sky pixels sit on the far plane: 0 in Forward+, 1 in the Compatibility renderer.
    local raw: number = texture(SceneDepth, ScreenUV).x
    local compatibility: bool = CompatibilityDepth > 0.5
    local sky: bool = if compatibility then raw > 0.99999 else raw < 0.00001
    if not sky then
        local depth: number = if compatibility then raw * 2.0 - 1.0 else raw
        local scene: vec4 = InverseProjectionMatrix * vec4(ScreenUV * 2.0 - 1.0, depth, 1.0)
        if length(scene.xyz / scene.w) < along then
            discard()
        end
    end

    local closest: number = length(toCenter - ray * along) / StarRadius
    local around: vec3 = normalize(toCenter - ray * along)
    local streaks: number = fbm(around * 6.0 + vec3(Time * 0.05), 4)
    local halo: number = exp(-(closest - 1.0) / Reach) * smoothstep(0.98, 1.05, closest)
    local rays: number = exp(-(closest - 1.0) / (Reach * 3.0)) * smoothstep(0.55, 0.9, streaks) * 0.25
    Albedo = Tint * (halo + rays) * 1.4
end
