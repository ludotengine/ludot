shader spatial
renderMode("unshaded", "blend_add", "cull_front", "depth_draw_never")

export Tint: vec3 = vec3(0.12, 0.48, 0.95)
export Strength: number = 0.6 in 0 to 4 step 0.1

function fragment()
    local facing: number = abs(dot(normalize(Normal), normalize(-Vertex)))
    local rim: number = pow(1.0 - facing, 2.4)
    Albedo = Tint * Strength
    Emission = Tint * rim * Strength
    Alpha = rim * 0.65
end
