#!/usr/bin/env python
Import('env')
Import('env_modules')
from pathlib import Path
ludot = env_modules.Clone()
root = Path(Dir('#').abspath).parent
ludot.Append(CPPPATH=[str(root / 'language/include')])
for component in ['Common', 'Ast', 'Bytecode', 'Inliner', 'Compiler', 'VM']:
    ludot.Append(CPPPATH=[str(root / 'luau' / component / 'include')])
ludot.Append(CPPPATH=[str(root / 'luau/VM/src'), str(root / 'luau/Bytecode/src')])
if env['platform'] == 'windows' and not env['use_mingw']:
    ludot.Append(CCFLAGS=['/EHsc'])
elif env['platform'] == 'web':
    # Luau raises errors as C++ exceptions. Godot's web build uses wasm setjmp/longjmp,
    # which only combines with native wasm exceptions, at compile and link time.
    ludot.Append(CXXFLAGS=['-fexceptions', '-fwasm-exceptions'])
    env.Append(LINKFLAGS=['-fwasm-exceptions'])
else:
    ludot.Append(CXXFLAGS=['-fexceptions'])
if env.editor_build:
    import importlib.util
    for component in ['Analysis', 'Config']:
        ludot.Append(CPPPATH=[str(root / 'luau' / component / 'include')])
    spec = importlib.util.spec_from_file_location('embed_mcp_addon', str(Path(Dir('.').abspath) / 'embed_mcp_addon.py'))
    embed_mcp_addon = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(embed_mcp_addon)
    addon_dir = root / 'mcp/godot/addons/godot_mcp'
    addon_sources = [
        str(path)
        for path in sorted(addon_dir.rglob('*'))
        if path.is_file()
        and not path.name.endswith('.import')
        and '__pycache__' not in path.parts
        and not any(part.startswith('.') for part in path.relative_to(addon_dir).parts)
    ]
    ludot['LUDOT_MCP_ADDON_DIR'] = str(addon_dir)
    mcp_header = ludot.Command(
        'generated/ludot_mcp_addon.gen.h',
        addon_sources + ['embed_mcp_addon.py'],
        env.Run(embed_mcp_addon.scons_action),
    )
    ludot.Append(CPPPATH=[Dir('generated').abspath])

luau_build = ludot.Clone()
# Luau intentionally uses constructor parameters named after their members. Its
# own build does not enable shadow warnings; inheriting Godot's policy emits tens
# of thousands of diagnostics from these headers during a native engine build.
luau_build['CCFLAGS'] = [flag for flag in luau_build['CCFLAGS'] if flag not in {
    '-Wshadow', '-Wshadow-field-in-constructor', '-Wshadow-uncaptured-local', '/w34458',
}]
if env['platform'] == 'windows' and not env['use_mingw']:
    # Godot uses /fp:strict, which enables FP exceptions. Luau temporarily turns
    # precise arithmetic off for selected VM operations, incompatible with those
    # exceptions. Use MSVC's default precise mode for Luau sources only.
    luau_build['CCFLAGS'] = [flag for flag in luau_build['CCFLAGS'] if not flag.startswith('/fp:')]
    luau_build.Append(CCFLAGS=['/fp:precise'])
compiler_build = luau_build.Clone()
compiler_build.Append(CPPDEFINES=['LUAU_ENABLE_ASSERT'])

if env.editor_build:
    for component in ['Analysis', 'Config']:
        for source in sorted((root / 'luau' / component / 'src').glob('*.cpp')):
            env.modules_sources.append(luau_build.Object(target='generated/' + component + '/' + source.stem, source=str(source)))
ludot.add_source_files(env.modules_sources, '*.cpp')
for component in ['Common', 'Ast', 'Bytecode', 'Inliner', 'Compiler', 'VM']:
    component_build = compiler_build if component in ['Ast', 'Compiler'] else luau_build
    for source in sorted((root / 'luau' / component / 'src').glob('*.cpp')):
        obj = component_build.Object(target='generated/' + component + '/' + source.stem, source=str(source))
        env.modules_sources.append(obj)
env.modules_sources.append(ludot.Object(target='generated/shader', source=str(root / 'language/src/shader.cpp')))
