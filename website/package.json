{
	"name": "ludot-docs",
	"private": true,
	"type": "module",
	"scripts": {
		"docs:generate": "python3 scripts/generate.py",
		"dev": "npm run docs:generate && vitepress dev .",
		"build": "npm run docs:generate && node --max-old-space-size=6144 node_modules/vitepress/bin/vitepress.js build .",
		"preview": "vitepress preview .",
		"test": "node --test scripts/*.test.mjs"
	},
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/legacy-modes": "^6.5.5",
		"@codemirror/lint": "^6.9.8",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@phosphor-icons/vue": "2.2.1",
		"@shikijs/langs": "2.5.0",
		"@shikijs/themes": "2.5.0",
		"codemirror": "^6.0.2",
		"shiki": "2.5.0",
		"vitepress": "1.6.4",
		"vue": "3.5.46"
	},
	"overrides": {
		"vite": "6.4.6"
	}
}
